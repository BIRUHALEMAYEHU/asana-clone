# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase Postgres — use the pooler URLs from Project → Connect
# DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true) for the app
# DIRECT_URL   = session pooler (port 5432) for Prisma migrations
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign auth + invitation JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Port Express listens on. Railway/Render inject this automatically; defaults to 3001.
PORT=3001

# Public base URL used to build invitation links. Must be the deployed URL in production.
FRONTEND_URL=http://localhost:5173

# Set to "production" on the host; leave unset locally.
NODE_ENV=development

# SMTP host for invitation emails. If unset, the server falls back to Ethereal test email.
SMTP_HOST=

# SMTP port (defaults to 587 when unset).
SMTP_PORT=587

# "true" for implicit TLS (port 465), otherwise "false".
SMTP_SECURE=false

# SMTP username.
SMTP_USER=

# SMTP password or app-specific password.
SMTP_PASS=

# From header on outgoing invitation emails.
EMAIL_FROM="TeamFlow <no-reply@example.com>"
